      "seed": 1574763837,
      "version": 73,
      "versionNonce": 1063993789,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787161319073,
      "link": null,
      "locked": false,
      "text": "uint8_t = unsigned integer, 8 bits.\n\nWhat that range looks like\nBinary: 00000000 to 11111111 (8 bits, all combinations)\nDecimal: 0 to 255 (2⁸ = 256 possible values, starting from 0)\nHex: 0x00 to 0xFF",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "uint8_t = unsigned integer, 8 bits.\n\nWhat that range looks like\nBinary: 00000000 to 11111111 (8 bits, all combinations)\nDecimal: 0 to 255 (2⁸ = 256 possible values, starting from 0)\nHex: 0x00 to 0xFF",
      "autoResize": true,
      "lineHeight": 1.25
    },
