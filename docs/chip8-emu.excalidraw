      "versionNonce": 150180491,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787256208934,
      "link": null,
      "locked": false,
      "text": "FOLLOWED COWGOD'S TUTORIAL FOR THIS LOGIC,\nCALL AND RETURN CAN BE DONE IN AN INVERSE \nWAY TOO, WHERE IN RETURN WE DECREMENT SP\nFIRST, BUT IT WORKS HERE TOO IF WE FOLLOW THIS\nLOGIC.",
      "fontSize": 32.26666666666684,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "FOLLOWED COWGOD'S TUTORIAL FOR THIS LOGIC,\nCALL AND RETURN CAN BE DONE IN AN INVERSE \nWAY TOO, WHERE IN RETURN WE DECREMENT SP\nFIRST, BUT IT WORKS HERE TOO IF WE FOLLOW THIS\nLOGIC.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "V7KErDnC1KuArctQiSirb",
      "type": "text",
      "x": 20299.072929605856,
      "y": 16219.758495823302,
