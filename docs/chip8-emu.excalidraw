      "updated": 1787076495340,
      "link": null,
      "locked": false,
      "text": "SDL: ",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SDL: ",
      "autoResize": true,
