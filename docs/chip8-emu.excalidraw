    },
    {
      "id": "pMV4XbxuU0O-uHceHYR_J",
      "type": "text",
      "x": 24360.672778562166,
      "y": 20443.99183949308,
      "width": 913,
      "height": 225,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#fefffe",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "brL",
      "roundness": null,
      "seed": 1434513733,
      "version": 65,
      "versionNonce": 362822213,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787256205609,
      "link": null,
      "locked": false,
      "text": "Very important note:\nCycle() (fetch-decode-execute one instruction) should\nrun fast — ideally ~500-700 times per second (or whatever speed you configure), \nsince that's roughly how fast real CHIP-8 hardware executed instructions.\n\nUpdate() (push display[] to the screen) should run at a much slower, fixed \nrate — typically 60 times per second (matching typical screen refresh rates), \nsince there's no point redrawing the screen more often than a monitor can even \nshow new frames, and doing so would just waste CPU/GPU work for no visible benefit.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Very important note:\nCycle() (fetch-decode-execute one instruction) should\nrun fast — ideally ~500-700 times per second (or whatever speed you configure), \nsince that's roughly how fast real CHIP-8 hardware executed instructions.\n\nUpdate() (push display[] to the screen) should run at a much slower, fixed \nrate — typically 60 times per second (matching typical screen refresh rates), \nsince there's no point redrawing the screen more often than a monitor can even \nshow new frames, and doing so would just waste CPU/GPU work for no visible benefit.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "f90gbbd8qZj_KgopaLXFh",
      "type": "image",
      "x": 24063.630728464694,
      "y": 20743.907456348774,
      "width": 1361.8000068148322,
