      "link": null,
      "locked": false,
      "text": "N: The fourth nibble. A 4-bit number.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "N: The fourth nibble. A 4-bit number.",
      "autoResize": true,
