    },
    {
      "id": "wp-ajkhW12FQAY_RuW7Mq",
      "type": "text",
      "x": 21754.860539138685,
      "y": 18092.625410809396,
      "width": 246.67340790684466,
      "height": 475,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bnt",
      "roundness": null,
      "seed": 1300607586,
      "version": 95,
      "versionNonce": 528526398,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787076509443,
      "link": null,
      "locked": false,
      "text": "A thin abstraction\nlayer over the OS's\nactual\nwindowing/graphics/inp\nut/audio APIs. Without\nSDL, if you wanted a\nwindow on screen you'd\nbe writing directly\nagainst Win32 APIs on\nWindows, X11/Wayland\non Linux, Cocoa on Mac\n— all completely\ndifferent APIs. SDL\ngives you one API that\nworks the same way\nacross all of them,\nand it handles the OS-\nspecific plumbing\ninternally.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A thin abstraction layer over the OS's actual windowing/graphics/input/audio APIs. Without SDL, if you wanted a window on screen you'd be writing directly against Win32 APIs on Windows, X11/Wayland on Linux, Cocoa on Mac — all completely different APIs. SDL gives you one API that works the same way across all of them, and it handles the OS-specific plumbing internally.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "ODJJO9T51LzJRI74UAavI",
      "type": "rectangle",
      "x": 21702.016185268207,
      "y": 18041.41139476913,
      "width": 334.07801001487314,
      "height": 558.9741005556098,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bnu",
      "roundness": {
        "type": 3
      },
      "seed": 1159017662,
      "version": 174,
      "versionNonce": 1222017342,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787076539786,
      "link": null,
      "locked": false
    },
    {
      "id": "rz5ck8YO1eRUnuO6coLTF",
      "type": "text",
      "x": 22061.290022854035,
      "y": 18144.625565835726,
      "width": 121,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
