      "index": "bp0",
      "roundness": null,
      "seed": 1330208638,
      "version": 119,
      "versionNonce": 675195326,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787077856694,
      "link": null,
      "locked": false,
      "text": "NN: The second byte (third and fourth nibbles). An 8-bit immediate\nnumber.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "NN: The second byte (third and fourth nibbles). An 8-bit immediate number.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "L8U6r8p71m1nesxVxQ85N",
      "type": "text",
      "x": 18992.529540481366,
      "y": 20071.454827957456,
      "width": 748,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
