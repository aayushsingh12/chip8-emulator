      "index": "box",
      "roundness": null,
      "seed": 1523707874,
      "version": 63,
      "versionNonce": 1807807550,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787077841213,
      "link": null,
      "locked": false,
      "text": "X: The second nibble. Used to look up one of the 16 registers (VX) from\nV0 through VF.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "X: The second nibble. Used to look up one of the 16 registers (VX) from V0 through VF.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "y3vPNa-by539vF8xMdUSK",
      "type": "text",
      "x": 18999.597421510392,
      "y": 19916.454827957456,
      "width": 770,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "boy",
      "roundness": null,
      "seed": 1735325502,
      "version": 63,
      "versionNonce": 1381219454,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787077841213,
      "link": null,
      "locked": false,
      "text": "Y: The third nibble. Also used to look up one of the 16 registers (VY)\nfrom V0 through VF.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Y: The third nibble. Also used to look up one of the 16 registers (VY) from V0 through VF.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "oh6lXhTc4N9iQFqTJBV9t",
      "type": "text",
      "x": 19001.92426797255,
      "y": 19975.403917185686,
