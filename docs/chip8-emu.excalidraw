    {
      "id": "jjMOCm1p-ZeHUktCSBzQ3",
      "type": "text",
      "x": 24121.94246292034,
      "y": 21658.63466803795,
      "width": 1155,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#fefffe",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "brN",
      "roundness": null,
      "seed": 996494149,
      "version": 314,
      "versionNonce": 1731210501,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787256205610,
      "link": null,
      "locked": false,
      "text": "In this code, Cycle() and Update() run every dt. This will work but its not very performance optimal, as \nUpdate() shouldnt really be running everytime Cycle does. Theres no point in redrawing screen more often \nthan a monitor can show frames",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "In this code, Cycle() and Update() run every dt. This will work but its not very performance optimal, as \nUpdate() shouldnt really be running everytime Cycle does. Theres no point in redrawing screen more often \nthan a monitor can show frames",
      "autoResize": true,
      "lineHeight": 1.25
    },
