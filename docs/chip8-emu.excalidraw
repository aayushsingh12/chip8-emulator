      "isDeleted": false,
      "boundElements": null,
      "updated": 1787256205610,
      "link": null,
      "locked": false,
      "text": "Relatively a better way. GPU is rendering and updating the window slower, at 60Hz, and the CPU cycle timing is faster ",
      "fontSize": 19.313047971608466,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Relatively a better way. GPU is rendering and updating the window slower, at 60Hz, and the CPU cycle timing is faster ",
