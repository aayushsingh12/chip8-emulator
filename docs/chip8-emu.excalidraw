    {
      "id": "hSf3oko895A5eCFMzX1tq",
      "type": "text",
      "x": 24598.306262939186,
      "y": 18528.091625706114,
      "width": 816.3466666666712,
      "height": 201.66666666666774,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#fefffe",
      "fillStyle": "solid",
      "strokeWidth": 4,
