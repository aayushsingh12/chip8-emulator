    {
      "id": "AMzJyPJGjJRG2xYZb2udZ",
      "type": "text",
      "x": 19253.36781096864,
      "y": 20503.94515050436,
      "width": 670.99609375,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#fefffe",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bpT",
