    {
      "id": "IOH456YHBgGOLwTOkjYf8",
      "type": "text",
      "x": 22826.86602967409,
      "y": 19514.672789954537,
      "width": 617.0625607670012,
      "height": 46.66748046874999,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#fefffe",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bpO",
      "roundness": null,
      "seed": 1323348179,
      "version": 303,
      "versionNonce": 1509217931,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787256201849,
      "link": null,
      "locked": false,
      "text": "For hex literals specifically, C++ has a rule: the compiler picks the smallest type that can hold the value, checking\ntypes in this order: int, then unsigned int, then long, then unsigned long, etc. Since 0x0FFF (4095) fits comfortably\nwithin a signed int's range, 0x0FFF defaults to plain int (signed), not unsigned — even though hex literals often \"feel\"\nunsigned to people",
      "fontSize": 9.333496093749998,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "For hex literals specifically, C++ has a rule: the compiler picks the smallest type that can hold the value, checking types in this order: int, then unsigned int, then long, then unsigned long, etc. Since 0x0FFF (4095) fits comfortably within a signed int's range, 0x0FFF defaults to plain int (signed), not unsigned — even though hex literals often \"feel\" unsigned to people",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "VjX6PcytI70a1sQza5AC0",
      "type": "text",
      "x": 19261.345539863618,
      "y": 20693.513786172764,
      "width": 220,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#fefffe",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bpP",
      "roundness": null,
      "seed": 1069701491,
      "version": 366,
      "versionNonce": 1261826781,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787161873870,
      "link": null,
      "locked": false,
      "text": "0xFF\n\n=1111 1111\n\n\n0x2F0C\n\n=0010 1111 0000 1100",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "0xFF\n\n=1111 1111\n\n\n0x2F0C\n\n=0010 1111 0000 1100",
      "autoResize": true,
      "lineHeight": 1.25
    },
